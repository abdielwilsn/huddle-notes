{
  "manifest_version": 3,
  "name": "Huddle Notes",
  "version": "1.0.0",
  "description": "Record meetings from your own browser (no bot joins the call) and get a transcript, summary and action items.",
  "permissions": ["activeTab", "tabCapture", "desktopCapture", "offscreen", "storage", "unlimitedStorage"],
  "host_permissions": ["https://api.groq.com/*", "https://api.openai.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Huddle Notes",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "options_page": "options.html",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "commands": {
    "toggle-recording": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Start / stop recording the current tab"
    }
  }
}
